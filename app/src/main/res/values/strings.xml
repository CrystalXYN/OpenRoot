    <string name="c98260_profile_title">Profile</string>
    <string name="c98260_profile_auto">Auto · this kernel</string>
    <string name="c98260_profile_note">The snapshot staged as --profile. Auto takes the release read from the device; a picked one overrides it, and its kptr / panic addresses come from the same kallsyms pass.</string>
    <string name="c98260_profile_none">No parsed snapshot on this device: the built-in table is used. Import a boot.img on the Profile tab to make one selectable here.</string>
    <string name="c98260_mode_title">Mode</string>
    <string name="c98260_mode_full">Full escalation</string>
    <string name="c98260_mode_selinux">SELinux only</string>
    <string name="c98260_mode_poke">Write zero</string>
    <string name="c98260_mode_lmap">Leak page_offset</string>
    <string name="c98260_mode_cred">Probe cred</string>
    <string name="c98260_mode_check">Check target</string>
    <string name="c98260_mode_dump">Dump profile</string>
    <string name="c98260_selinux_title">SELinux only</string>
    <string name="c98260_selinux_note">Same chain, stopped the moment SELinux reads back permissive: no forged cred, no root shell, nothing left running. The device stays permissive until reboot.</string>
    <string name="c98260_poke_title">Targets</string>    <string name="c98260_poke_panic">panic_on_oops = 0</string>
    <string name="c98260_poke_panic_note">Clears panic_timeout too, and always runs first</string>
    <string name="c98260_poke_kptr">kptr_restrict, perf_event_paranoid = 0</string>
    <string name="c98260_poke_kptr_note">Opens /proc/kallsyms to unprivileged readers</string>
    <string name="c98260_poke_builtin_note">The two built-in targets read kptr_restrict, perf_event_paranoid and panic_on_oops from the selected profile (its boot.img kallsyms). Without them only 6.1.134 falls back to built-in values; other KMIs skip the target instead of writing a wrong address.</string>
